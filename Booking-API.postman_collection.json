{
    "info": {
        "name": "Booking API — ASE Take-Home",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000"
        },
        {
            "key": "bookingId",
            "value": ""
        },
        {
            "key": "secondBookingId",
            "value": ""
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "const isoDate = (daysAhead) => {",
                    "    const now = new Date();",
                    "    const target = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysAhead));",
                    "    return target.toISOString().slice(0, 10);",
                    "};",
                    "",
                    "pm.collectionVariables.set('bookingDate', isoDate(30));",
                    "pm.collectionVariables.set('rescheduleDate', isoDate(31));",
                    "pm.collectionVariables.set('emptyDate', isoDate(45));"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Health check",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/up",
                    "host": ["{{baseUrl}}"],
                    "path": ["up"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('returns 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create a booking",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Jane Silva\",\n    \"email\": \"jane@example.com\",\n    \"date\": \"{{bookingDate}}\",\n    \"slot\": \"10:00\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/bookings",
                    "host": ["{{baseUrl}}"],
                    "path": ["bookings"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('returns 201', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "const body = pm.response.json();",
                            "",
                            "pm.test('returns the created booking', function () {",
                            "    pm.expect(body.name).to.eql('Jane Silva');",
                            "    pm.expect(body.email).to.eql('jane@example.com');",
                            "    pm.expect(body.date).to.eql(pm.collectionVariables.get('bookingDate'));",
                            "    pm.expect(body.slot).to.eql('10:00');",
                            "});",
                            "",
                            "pm.collectionVariables.set('bookingId', body.id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create a conflicting booking (same date and slot)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"John Marsh\",\n    \"email\": \"john@example.com\",\n    \"date\": \"{{bookingDate}}\",\n    \"slot\": \"10:00\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/bookings",
                    "host": ["{{baseUrl}}"],
                    "path": ["bookings"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('returns 409', function () {",
                            "    pm.response.to.have.status(409);",
                            "});",
                            "",
                            "pm.test('explains the slot is taken', function () {",
                            "    pm.expect(pm.response.json().message).to.include('is already booked');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create a booking with missing or invalid fields",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"\",\n    \"email\": \"not-an-email\",\n    \"date\": \"{{bookingDate}}\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/bookings",
                    "host": ["{{baseUrl}}"],
                    "path": ["bookings"]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('returns 422', function () {",
                            "    pm.response.to.have.status(422);",
                            "});",
                            "",
                            "pm.test('reports each invalid field', function () {",
                            "    const errors = pm.response.json().errors;",
                            "    pm.expect(errors).to.have.property('name');",
                            "    pm.expect(errors).to.have.property('email');",
                            "    pm.expect(errors).to.have.property('slot');",
                            "});"
                        ]
                    }
                }
            ]
        },
