        {
            "name": "List bookings filtered by date",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/bookings?date={{bookingDate}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["bookings"],
                    "query": [
                        {
                            "key": "date",
                            "value": "{{bookingDate}}"
                        }
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('returns 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const body = pm.response.json();",
                            "const date = pm.collectionVariables.get('bookingDate');",
                            "",
                            "pm.test('every booking is on the requested date', function () {",
                            "    pm.expect(body).to.be.an('array');",
                            "    body.forEach(function (booking) {",
                            "        pm.expect(booking.date).to.eql(date);",
                            "    });",
                            "});"
                        ]
                    }
                }
            ]
        },
