APP_NAME="Booking API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=booking
DB_USERNAME=booking
DB_PASSWORD=secret

CACHE_STORE=array
QUEUE_CONNECTION=sync

BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_RATE_LIMIT=60,1
